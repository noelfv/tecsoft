<root>
    <filters>
        <filter type="Dummy" id="HIDDING" />
        <filter type="Dummy" id="HIDDING_PLUS" symbol="+" />
        <filter type="Dummy" id="HIDDING_REST" symbol="-" />
    </filters>
    <macros>
        <macro type="Dummy" parsename="DATEM" />
    </macros>
    <formatters>
        <formatter id="testFilter">
            <field type="Dummy" id="00" length="6" protec="NONE">000050</field>
            <field type="Dummy" id="01" length="8" protec="HIDDING">FIX03   </field>
            <field type="Dummy" id="03" length="8" protec="HIDDING_PLUS">12345678</field>
        </formatter>    
        <formatter id="testFilterWithGroup">    
            <field type="Dummy" id="00" length="4">0200</field>
            <field type="Dummy" id="01" length="16" protec="HIDDING">FABCC28188E0D008</field>
            <field type="Dummy" id="02" length="10" format="n" >234</field>
            <field type="Dummy" id="04" length="8">5421</field>
            <field type="GDummy" id="06" length="12" nl="3" protec="HIDDING_REST">
                <field type="Dummy" id="01" length="8" >qwerty</field>
                <field type="Dummy" id="02" length="3" protec="HIDDING_REST">89</field>
            </field>
        </formatter>
        <formatter id="testFilterWithMacro">    
            <field type="Dummy" id="00" length="6" >000050</field>
            <field type="Dummy" id="01" length="8" protec="HIDDING">FIX03   </field>
            <field type="Dummy" id="03" length="8" parse="true" protec="HIDDING_PLUS">DATEM(yyyyMMdd)</field>
        </formatter>
        <formatter id="testFilterWithMacroDeepField">    
            <field type="Dummy" id="00" length="4">0200</field>
            <field type="Dummy" id="01" length="16" protec="HIDDING">FABCC28188E0D008</field>
            <field type="Dummy" id="02" length="10" format="n" >234</field>
            <field type="Dummy" id="04" length="8">5421</field>
            <field type="Dummy" id="05" length="8" parse="true" protec="HIDDING_PLUS">DATEM(yyyyMMdd)</field>
            <field type="GDummy" id="06" length="12" nl="3">
                <field type="Dummy" id="01" length="8" >qwerty</field>
                <field type="Dummy" id="02" length="3" protec="HIDDING_REST">89</field>
                <field type="Dummy" id="03" length="8" parse="true" protec="HIDDING_PLUS">DATEM(yyyyMMdd)</field>
            </field>
        </formatter>
    </formatters>
</root>
