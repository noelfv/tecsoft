<root>
    <formatters>
        <formatter id="T01">
            <field id="01" type="Fixed" length="4">AAAA</field>
            <field id="02" type="Fixed" length="3">BBB</field>
            <field id="03" type="Fixed" length="2">CC</field>
            <field id="04" type="Case" casefields="01,02,03" >
                <case value="AAAA|BBB|CC"/>
                <case value="AAAA|BBB|DD"/>
                <case value="AAAA|BBB|EE"/>
                <case value="AAAA|BBB|FF">
                    <field id="04-1-1" type="Fixed" length="6"></field>
                    <field id="04-1-2" type="Fixed" length="5"></field>
                    <field id="04-1-3" type="Fixed" length="9"></field>
                </case>
                <case value="AAAA|DDD|CC"/>
                <case value="AAAA|EEE|CC">
                    <field id="04-2-1" type="Fixed" length="7"></field>
                    <field id="04-2-2" type="Fixed" length="8"></field>
                </case>
                <default>
                    <field id="04-3-1" type="Fixed" length="3"></field>
                </default>
            </field>
        </formatter>
        <formatter id="T02">
            <field id="01" type="Fixed" length="4">AAAA</field>
            <field id="02" type="Fixed" length="3">BBB</field>
            <field id="03" type="Fixed" length="2">CC</field>
            <field id="04" type="Case" casefields="01,02,03" >
                <case value="AAAA|BBB|CC"/>
                <case value="AAAA|BBB|DD"/>
                <case value="AAAA|BBB|EE"/>
                <case value="AAAA|BBB|FF">
                    <field id="04-1-1" type="Fixed" length="6">666666</field>
                    <field id="04-1-2" type="Fixed" length="5">55555</field>
                    <field id="04-1-3" type="Fixed" length="9">999999999</field>
                </case>
                <case value="AAAA|DDD|CC"/>
                <case value="AAAA|EEE|CC">
                    <field id="04-2-1" type="Fixed" length="7"></field>
                    <field id="04-2-2" type="Fixed" length="8"></field>
                </case>
            </field>
        </formatter>
    </formatters>
</root>
