<log4j:configuration xmlns:log4j="http://jakarta.apache.org/log4j/">
    <appender name="CONSOLE" class="org.apache.log4j.ConsoleAppender">
        <param name="Target" value="System.out"/>
        <layout class="org.apache.log4j.PatternLayout">
            <param name="ConversionPattern" value="%d{HH:mm:ss,SSS} [%-10t] %-5p (%c).%M:%L %m%n" />
        </layout>
    </appender>

    <appender name="DAYFILE" class="org.apache.log4j.DailyRollingFileAppender">
        <param name="File" value="tester.log" />
        <param name="DatePattern" value="'.'yyyyMMdd" />
        <param name="Append" value="true" />
        <layout class="org.apache.log4j.PatternLayout">
            <param name="ConversionPattern" value="%d{HH:mm:ss,SSS} [%-10t] %-5p (%c).%M:%L %m%n" />
        </layout>
    </appender>
    
    <appender name="ROLLFILE" class="org.apache.log4j.RollingFileAppender">
        <param name="file" value="tester.log"/>
        <param name="MaxFileSize" value="2048KB" />
        <!-- Keep one backup file -->
        <param name="MaxBackupIndex" value="20"/>
        <layout class="org.apache.log4j.PatternLayout">
            <param name="ConversionPattern" value="%d{HH:mm:ss,SSS} [%-10t] %-5p (%c).%M:%L %m%n"/>
        </layout>
    </appender>

    <appender name="TEXTAREA" class="com.novatronic.formatter.gui.log.JTextAreaAppender">
        <param name="Threshold" value="INFO"/>
        <layout class="org.apache.log4j.PatternLayout">
            <param name="ConversionPattern" value="[%d{HH:mm:ss}]%m%n"/>
        </layout>
    </appender>
    
    <category name="com.novatronic.formatter.gui">
        <priority value="TRACE"/>
    </category>
    
    <root>
        <priority value="TRACE" />
        <appender-ref ref="DAYFILE" />
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="TEXTAREA" />
    </root>

</log4j:configuration>
