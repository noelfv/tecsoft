<root>
    <filters>
        <filter type="Dummy" id="HIDDING" />
        <filter type="Dummy" id="HIDDING_PLUS" symbol="+" />
        <filter type="Dummy" id="HIDDING_REST" symbol="-" />
    </filters>
    <formatters>
        <formatter id="test">
            <field type="CollectGroup" id="M" exp="P:4,Q:3,S:8" gname="test" >
                <field type="Fixed"  id="a" length="2" />
                <field type="Fixed"  id="b" length="5" />
                <field type="Fixed"  id="c" length="3" />
            </field>
            <field type="Fixed"  id="N" length="3" />
            <field type="Fixed"  id="P" length="4" />
            <field type="Fixed"  id="Q" length="3" />
            <field type="Fixed"  id="R" length="2" />
            <field type="Fixed"  id="S" length="6" />
            <field type="CollectGroup" id="T" collec="true" null="true" gname="test"/>
        </formatter>
        <formatter id="testPutBytesUp">
            <field type="CollectGroup" id="M" exp="P:4,Q:3,S:8" gname="A" >
                <field type="Fixed"  id="a" length="2" />
                <field type="Fixed"  id="b" length="5" />
                <field type="Fixed"  id="c" length="3" />
            </field>
            <field type="Fixed"  id="N" length="3" />
            <field type="Fixed"  id="P" length="4" />
            <field type="Fixed"  id="Q" length="3" />
            <field type="Fixed"  id="R" length="2" />
            <field type="Fixed"  id="S" length="6" />
            <field type="CollectGroup" id="T" collec="true" null="true" gname="A"/>
        </formatter>
        <formatter id="testPutBytesDown">
            <field type="CollectGroup" id="M" null="true" gname="B"/>
            <field type="Fixed"  id="N" length="3" />
            <field type="Fixed"  id="P" length="4" />
            <field type="Fixed"  id="Q" length="3" />
            <field type="Fixed"  id="R" length="2" />
            <field type="Fixed"  id="S" length="6" />
            <field type="CollectGroup" id="T" exp="P:4,Q:3,S:8" collec="true" gname="B">
                <field type="Fixed"  id="a" length="2" />
                <field type="Fixed"  id="b" length="5" />
                <field type="Fixed"  id="c" length="3" />
            </field>
        </formatter>
        <formatter id="testReadBytes">
            <field type="CollectGroup" id="M" null="true" gname="C"/>
            <field type="Fixed"  id="P" length="3" />
            <field type="Fixed"  id="Q" length="4" />
            <field type="Fixed"  id="R" length="5" />
            <field type="Fixed"  id="S" length="1" />
            <field type="CollectGroup" id="T" exp="P:3,Q:4" collec="true" gname="C">
                <field type="Fixed"  id="a" length="3" />
                <field type="Fixed"  id="b" length="1" />
                <field type="Fixed"  id="c" length="2" />
                <field type="Fixed"  id="d" length="1" />
            </field>
        </formatter>
        <formatter id="testPutBytesLimit">
            <field type="CollectGroup" id="Data" gname="data" null="true"/>
            <field type="Fixed"  id="F1"  length="3" >FF1</field>
            <field type="Fixed"  id="F2"  length="4" >FF2</field>
            <field type="NVar"  id="CP1" nl="2" length="90" />
            <field type="NVar"  id="CP2" nl="3" length="90" />
            <field type="CollectGroup" id="Data_appl" exp="CP1:7,CP2:8" collec="true" gname="data">
                <field type="Fixed"  id="D1"  length="10" />
                <field type="Fixed"  id="D2"  length="5"/>
            </field>
        </formatter>
        <formatter id="testPutBytesLimit">
            <field type="CollectGroup" id="Data" gname="data" null="true"/>
            <field type="Fixed"  id="F1"  length="3" >FF1</field>
            <field type="Fixed"  id="F2"  length="4" >FF2</field>
            <field type="NVar"  id="CP1" nl="2" length="90" />
            <field type="NVar"  id="CP2" nl="3" length="90" />
            <field type="CollectGroup" id="Data_appl" exp="CP1:7,CP2:8" collec="true" gname="data">
                <field type="Fixed"  id="D1"  length="10" />
                <field type="Fixed"  id="D2"  length="5"/>
            </field>
        </formatter>
        <formatter id="testPartialDataFromConfig">
            <field type="CollectGroup" id="Data" gname="data" null="true"/>
            <field type="Group" id="01" >
                <field type="Fixed"  id="01"  length="2" >01</field>
                <field type="Fixed"  id="02"  length="2" >02</field>
                <field type="Fixed"  id="03"  length="2" >03</field>
                <field type="Fixed"  id="04"  length="9" >123abc123</field>
            </field>
            <field type="CollectGroup" id="Data_appl" exp="01.04:6" collec="true" gname="data">
                <field type="Fixed"  id="D1"  length="3" >D01</field>
                <field type="Fixed"  id="D2"  length="3">D02</field>
                <field type="Case"  id="D3"  casefields="01.01,Data_appl.D1">
                    <case value="01|D01">
                        <field type="Fixed"  id="C01"  length="3" >C01</field>
                    </case>
                    <default />
                </field>
            </field>
        </formatter>
        <formatter id="testReadBytesFilter">
            <field type="CollectGroup" id="M" null="true" gname="C"/>
            <field type="Fixed"  id="P" length="3" protec="HIDDING"/>
            <field type="Fixed"  id="Q" length="4" protec="HIDDING_PLUS"/>
            <field type="Fixed"  id="R" length="5" />
            <field type="Fixed"  id="S" length="1" protec="HIDDING_REST"/>
            <field type="CollectGroup" id="T" exp="P:3,Q:4" collec="true" gname="C">
                <field type="Fixed"  id="a" length="3" />
                <field type="Fixed"  id="b" length="1" protec="HIDDING"/>
                <field type="Fixed"  id="c" length="2" />
                <field type="Fixed"  id="d" length="1" protec="HIDDING"/>
            </field>
        </formatter>
        <formatter id="testPartialDataFromConfigFilter">
            <field type="CollectGroup" id="Data" gname="data" null="true"/>
            <field type="Group" id="01" >
                <field type="Fixed"  id="01"  length="2" protec="HIDDING">01</field>
                <field type="Fixed"  id="02"  length="2" >02</field>
                <field type="Fixed"  id="03"  length="2" protec="HIDDING">03</field>
                <field type="Fixed"  id="04"  length="9" >123abc123</field>
            </field>
            <field type="CollectGroup" id="Data_appl" exp="01.04:6" collec="true" gname="data">
                <field type="Fixed"  id="D1"  length="3" protec="HIDDING">D01</field>
                <field type="Fixed"  id="D2"  length="3">D02</field>
                <field type="Case"  id="D3"  casefields="01.01,Data_appl.D1">
                    <case value="01|D01">
                        <field type="Fixed"  id="C01"  length="3" protec="HIDDING">C01</field>
                    </case>
                    <default />
                </field>
            </field>
        </formatter>
    </formatters>
</root>
